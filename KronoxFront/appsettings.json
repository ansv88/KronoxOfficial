{
  "ApiSettings": {
    "BaseUrl": "https://localhost:7231/",
    "ApiKey": "denna-nyckel-ersätts-i-produktion"
  },
  "NewsSettings": {
    "PreviewLength": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "KronoxFront.Services.ApiAuthHandler": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "${basedir}/log_kronoxfront-internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
      { "assembly": "NLog.Database" }
    ],
    "variables": {
      "var_logdir": "${basedir}"
    },
    "time": {
      "type": "AccurateLocal"
    },
    "default-wrapper": {
      "type": "AsyncWrapper",
      "overflowAction": "Block"
    },
    "targets": {
      "all-file": {
        "type": "File",
        "fileName": "${var_logdir}/log_kronoxfront-nlog-all-${shortdate}.log",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "timestamp",
              "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff}"
            },
            {
              "name": "level",
              "layout": "${level}"
            },
            {
              "name": "logger",
              "layout": "${logger}"
            },
            {
              "name": "message",
              "layout": "${message:raw=true}"
            },
            {
              "name": "properties",
              "encode": false,
              "layout": {
                "type": "JsonLayout",
                "includeallproperties": "true"
              }
            }
          ]
        }
      },
      "own-console": {
        "type": "LimitingWrapper",
        "interval": "00:00:01",
        "messageLimit": 100,
        "target": {
          "type": "ColoredConsole",
          "layout": "${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|${callsite}",
          "rowHighlightingRules": [
            {
              "condition": "level == LogLevel.Error",
              "foregroundColor": "Red"
            },
            {
              "condition": "level == LogLevel.Fatal",
              "foregroundColor": "Red",
              "backgroundColor": "White"
            }
          ]
        }
      },
      "database": {
        "type": "Database",
        "dbProvider": "Microsoft.Data.SqlClient",
        "connectionString": "{secret:dsnApiDB}",
        "keepConnection": "true",
        "commandText": "insert into log_kronoxfront (time_stamp,level,logger,message,exception) values (@time_stamp, @level, @logger, @message, @exception);",
        "parameters": [
          {
            "name": "@time_stamp",
            "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff}",
            "dbType": "DbType.DateTime"
          },
          {
            "name": "@level",
            "layout": "${level}"
          },
          {
            "name": "@logger",
            "layout": "${logger}"
          },
          {
            "name": "@message",
            "layout": "${message}"
          },
          {
            "name": "@exception",
            "layout": "${exception:tostring}"
          }
        ]
      }
    },
    "rules": [

      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "database"
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "own-console",
        "filterDefaultAction": "Log",
        "filters": {
          "whenRepeated": {
            "layout": "${message}",
            "action": "Ignore"
          }
        }
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "all-file"
      }
    ]
  },
  "Recaptcha": {
    "SiteKey": "DIN_SITE_KEY_HÄR"
  },
  "AllowedHosts": "*",
  "Redirects": {
    "manualen": ""
  }
}