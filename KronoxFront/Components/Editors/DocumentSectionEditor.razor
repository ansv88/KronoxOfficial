@using KronoxFront.Services
@using KronoxFront.Components.Shared.Admin

<AdminSectionFrame Title="Dokumentsektion"
                   IconClass="fa-solid fa-file-alt"
                   ShowAdminButton="true"
                   AdminButtonUrl="/admin/documents/manage"
                   AdminButtonText="Hantera dokument"
                   AdminButtonIcon="fa-solid fa-cog">
    <ChildContent>
        <p class="text-muted mb-3">@Description</p>

        <div class="alert alert-info mb-0 d-flex">
            <i class="fa-solid fa-circle-info me-2 mt-1"></i>
            <div>
                <strong>Så fungerar dokumentsektionen</strong>
                <ul class="list-unstyled small mb-0 mt-2">
                    <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Kan aktiveras på valfri sida – inte bara dokumentsidan.</li>
                    <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Användare ser endast dokument för sina roller.</li>
                    <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Dokument grupperas automatiskt per kategori.</li>
                    <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Sök- och filtreringsfunktioner inkluderas.</li>
                    <li><i class="fa-solid fa-check text-success me-2"></i>Admin kan se och hantera arkiverade dokument.</li>
                </ul>
            </div>
        </div>
    </ChildContent>
</AdminSectionFrame>

@code {
    [Parameter] public string PageKey { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Dokumentsektion";
    [Parameter] public string Description { get; set; } = "Dokumentsektionen kan läggas till på valfri sida och visar automatiskt relevanta dokument baserat på användarens roller och behörigheter.";

}